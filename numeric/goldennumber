            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="max-w-7xl w-full mx-auto p-4 md:p-6 flex-grow grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- Left / Center Column: Canvas Viewport -->
        <div class="lg:col-span-8 flex flex-col space-y-4">
            <!-- Canvas Container Card -->
            <div class="glass-card rounded-2xl p-4 flex flex-col relative overflow-hidden shadow-2xl border border-slate-800">
                
                <!-- Instruction Header matching the image -->
                <div class="text-center py-2 mb-2 bg-slate-900/90 rounded-xl border border-slate-800/80">
                    <h2 class="text-base md:text-xl font-extrabold text-amber-300 tracking-wide">
                        Tentukan jumlah dari semua bilangan berikut.
                    </h2>
                </div>

                <!-- Top Canvas Overlay Controls -->
                <div class="flex items-center justify-between mb-2 z-10">
                    <div class="flex items-center space-x-2">
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse mr-1.5"></span>
                            <span id="status-badge">Menggambar Spiral...</span>
                        </span>
                    </div>

                    <div class="flex items-center space-x-2 bg-slate-900/80 p-1 rounded-lg border border-slate-800 text-xs">
                        <button onclick="zoomCanvas(1.2)" class="w-8 h-8 rounded-md hover:bg-slate-800 flex items-center justify-center text-slate-300 transition" title="Zoom In">
                            <i class="fa-solid fa-magnifying-glass-plus"></i>
                        </button>
                        <button onclick="zoomCanvas(0.8)" class="w-8 h-8 rounded-md hover:bg-slate-800 flex items-center justify-center text-slate-300 transition" title="Zoom Out">
                            <i class="fa-solid fa-magnifying-glass-minus"></i>
                        </button>
                        <button onclick="resetCamera()" class="w-8 h-8 rounded-md hover:bg-slate-800 flex items-center justify-center text-slate-300 transition" title="Reset Pandangan">
                            <i class="fa-solid fa-rotate-left"></i>
                        </button>
                        <button id="btn-toggle-sound" onclick="toggleAudio()" class="w-8 h-8 rounded-md hover:bg-slate-800 flex items-center justify-center text-amber-400 transition" title="Suara On/Off">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                    </div>
                </div>

                <!-- Interactive HTML5 Canvas -->
                <div class="relative w-full h-[440px] md:h-[520px] rounded-xl bg-slate-950 overflow-hidden border border-slate-800 cursor-grab active:cursor-grabbing" id="canvas-wrapper">
                    <canvas id="spiralCanvas" class="w-full h-full block"></canvas>
                    
                    <!-- Canvas Drag Hint Overlay -->
                    <div class="absolute bottom-3 right-3 pointer-events-none text-[10px] text-slate-400 bg-slate-900/90 px-2 py-1 rounded border border-slate-800">
                        <i class="fa-solid fa-hand-pointer mr-1"></i>Geser / Zoom untuk navigasi
                    </div>
                </div>

                <!-- Bottom Playback Controls (For Visualizer Mode) -->
                <div id="visualizer-controls" class="mt-4 pt-3 border-t border-slate-800 flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center space-x-2">
                        <button id="btn-play" onclick="togglePlay()" class="gold-bg-gradient hover:brightness-110 text-slate-950 px-5 py-2.5 rounded-xl font-bold flex items-center space-x-2 shadow-lg shadow-amber-500/20 transition-all active:scale-95">
                            <i id="icon-play" class="fa-solid fa-pause"></i>
                            <span id="text-play">Jeda</span>
                        </button>

                        <button onclick="restartAnimation()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-4 py-2.5 rounded-xl font-semibold flex items-center space-x-2 transition border border-slate-700">
                            <i class="fa-solid fa-rotate-right"></i>
                            <span class="hidden sm:inline">Ulangi</span>
                        </button>

                        <button onclick="stepPrevious()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 w-10 h-10 rounded-xl flex items-center justify-center transition border border-slate-700" title="Langkah Sebelumnya">
                            <i class="fa-solid fa-backward-step"></i>
