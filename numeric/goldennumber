<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Golden Ratio & Fibonacci Spiral Math Game</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
        }
        .gold-gradient-text {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .gold-bg-gradient {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        }
        .glass-card {
            background: rgba(30, 41, 59, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        canvas {
            touch-action: none;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between overflow-x-hidden">

    <!-- Header -->
    <header class="glass-card sticky top-0 z-30 px-4 py-3 border-b border-slate-800">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl gold-bg-gradient flex items-center justify-center text-slate-900 font-extrabold text-xl shadow-lg shadow-amber-500/20">
                    <i class="fa-solid font-bold">Φ</i>
                </div>
                <div>
                    <h1 class="text-lg md:text-xl font-bold gold-gradient-text leading-tight">Golden Spiral & Fibonacci Challenge</h1>
                    <p class="text-xs text-slate-400">Petualangan Matematika Rasio Keemasan</p>
                </div>
            </div>

            <!-- Mode Selector Tabs -->
            <div class="flex items-center bg-slate-900/80 p-1 rounded-xl border border-slate-800 text-xs md:text-sm font-medium">
                <button id="tab-visualizer" onclick="switchMode('visualizer')" class="px-3 md:px-4 py-1.5 rounded-lg bg-amber-500 text-slate-950 font-bold transition-all shadow-sm">
                    <i class="fa-solid fa-play mr-1.5"></i>Visualisasi Spiral
