                        <button onclick="stepNext()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 w-10 h-10 rounded-xl flex items-center justify-center transition border border-slate-700" title="Langkah Selanjutnya">
                            <i class="fa-solid fa-forward-step"></i>
